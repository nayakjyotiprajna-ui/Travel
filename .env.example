# ==========================================
# TRAVELTWIN ENVIRONMENT CONFIGURATION
# ==========================================

# Frontend (client/.env)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Backend (server/.env)
PORT=5000
MONGODB_URI=mongodb://localhost:27017/traveltwin
# For MongoDB Atlas in production:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/traveltwin?retryWrites=true&w=majority
JWT_SECRET=traveltwin_jwt_secret_token_key_change_in_production
CLIENT_URL=http://localhost:5173

# AI Integration (Supports Gemini / OpenAI compatible or direct inference; fallback engine active if blank)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
