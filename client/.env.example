# ==============================================================================
# TravelTwin — Client Environment Configuration (Firebase & API)
# ==============================================================================
# Instructions:
# 1. Create a Firebase project at https://console.firebase.google.com/
# 2. Add a Web App in Project Settings -> General -> Your apps -> Web app
# 3. Enable Authentication (Google & Email/Password providers) under Build -> Authentication -> Sign-in method
# 4. Enable Cloud Storage under Build -> Storage
# 5. Copy the configuration credentials and paste them below in client/.env
# ==============================================================================

# Backend API URL (leave blank to use the Vite proxy at http://localhost:5000)
VITE_API_URL=

# Firebase Web App SDK Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
